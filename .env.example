# AudioDaemon -- per-machine settings.
#
# Copy this file to `.env` (next to daemon.py) and change what you need. `.env`
# is git-ignored. A variable already set in the real environment wins over
# this file, so `$env:AUDIODAEMON_X = ...` still works for a one-off run.

# --- The browser (application-layer capture) ---------------------------------
# Your everyday browser is captured, on your own profile, once remote debugging
# is turned on at chrome://inspect/#remote-debugging (comet://inspect/... in
# Comet). The daemon finds it through the DevToolsActivePort file the browser
# writes into its User Data directory. Unset, it looks in Comet's, Chrome's,
# Edge's and Brave's; set this to pin one.
# AUDIODAEMON_BROWSER_DATA=C:\Users\you\AppData\Local\Perplexity\Comet\User Data

# --- The brain ---------------------------------------------------------------
AUDIODAEMON_MODEL=LiquidAI/lfm2.5-1.2b-instruct:latest
AUDIODAEMON_OLLAMA_HOST=http://localhost:11434

# --- ffmpeg ------------------------------------------------------------------
# Used when ffmpeg isn't on PATH.
AUDIODAEMON_FFMPEG_DIR=D:\envs\vanta\Library\bin
